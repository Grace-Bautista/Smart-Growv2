rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isActiveAdmin() {
      return signedIn()
        && userDoc(request.auth.uid).data.role == 'admin'
        && userDoc(request.auth.uid).data.status == 'active';
    }

    function isActiveUser() {
      return signedIn() && userDoc(request.auth.uid).data.status == 'active';
    }

    match /devices/{deviceId}/sensorHistory/{recordId} {
      allow read: if isActiveUser();
      allow create, update, delete: if false;
    }

    match /devices/{deviceId}/systemEvents/{eventId} {
      allow read: if isActiveUser();
      allow create, update, delete: if false;
    }

    match /devices/{deviceId}/historyMetadata/{metadataId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isActiveAdmin());
      allow list: if isActiveAdmin();
      allow create, delete: if false;
      allow update: if isActiveAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /audit_logs/{logId} {
      allow read: if isActiveAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
